{
  "folders": [
    {
      "name": "WinJitsu",
      "path": "."
    }
  ],
  // The project is always opened through this file, so every setting lives here. .vscode/ has no settings.json on
  // purpose (folder settings would override these) and holds launch.json, tasks.json and extensions.json instead,
  // which this file doesn't define: nothing is configured twice.
  "settings": {
    // The .venv made by the "WinJitsu: sync venv" task (uv sync) has winjitsu installed in editable mode, so the
    // Test Explorer imports this checkout and never the copy installed by the AUR package.
    "python.defaultInterpreterPath": "${workspaceFolder}/.venv/bin/python",

    // Stdlib unittest, discovered like `make test` and CI do; tests/ is the start directory, so `import fakes` works.
    "python.testing.unittestEnabled": true,
    "python.testing.pytestEnabled": false,
    "python.testing.unittestArgs": ["-v", "-s", "./tests", "-p", "test*.py"],

    // No formatter is configured and the code aligns imports, assignments and argparse calls by hand.
    "[python]": {
      "editor.formatOnSave": false
    },

    // Every file in the repository ends with exactly one newline and has no trailing whitespace.
    "files.trimTrailingWhitespace": true,
    "files.insertFinalNewline": true,
    "files.trimFinalNewlines": true,

    "files.exclude": {
      "**/__pycache__": true,
      "**/*.egg-info": true
    },
    // Search already skips what .gitignore lists; the file watcher doesn't.
    "files.watcherExclude": {
      "**/.venv/**": true,
      "build/**": true,
      "dist/**": true,
      "PKGs/**": true,
      "AUR/**": true,
      "arch/src/**": true,
      "arch/pkg/**": true,
      "arch/WinJitsu/**": true
    }
  }
}
